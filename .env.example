# Requeridas para iniciar la API
DATABASE_URL=postgresql://usuario:clave@host:5432/base
SESSION_SECRET=reemplaza-por-un-secreto-aleatorio-largo
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_KEY=tu-clave-de-servicio

# Opcionales: URL pública usada en enlaces de correo (usa la URL local del servidor para desarrollo)
APP_URL=http://localhost:2000
PORT=2000
NODE_ENV=development

# Correos transaccionales (Resend)
RESEND_API_KEY=
EMAIL_FROM=EduNexus <onboarding@resend.dev>

# Base de datos alternativa; si se define, tiene prioridad sobre DATABASE_URL
SUPABASE_DATABASE_URL=

# Google Classroom (integración OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Videollamadas LiveKit
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Notificaciones push (VAPID); sin estas claves quedan desactivadas
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@edunexus.app

# Integración Master2000 y alta inicial superadmin; configurar solo si se usan
MASTER2000_API_URL=
MASTER2000_API_KEY=
SUPER_ADMIN_SETUP_KEY=
